		variation Variation
			isDefault
			relationship: fc3cdb80-af91-42f1-b67c-f329acde0c50
			defaultHierarchy: LocalDateTable_32708496-c1b1-4e0c-85c7-e786cda4af2d.'Date Hierarchy'

